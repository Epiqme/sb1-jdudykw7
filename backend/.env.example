# Admin PIN that guards the /api/admin/* routes and the app's admin screen.
ADMIN_PIN=change-me

# Where the JSON database file is written (defaults to ./data/db.json).
# DATA_DIR=./data

# Deal-scan estimated savings rate (0.12 = 12%).
SAVINGS_RATE=0.12

# Price shown for Elite (informational; real charge is handled by Stripe/IAP).
ELITE_PRICE_USD=59

# --- Real payments ---
# Stripe secret key for web payments. Roll a FRESH one in your Stripe
# dashboard (the old key was exposed) and paste it here. Use a test key
# (sk_test_...) while testing, then swap to the live key (sk_live_...).
# STRIPE_SECRET_KEY=sk_live_...

# Apple in-app purchase shared secret (App Store Connect → your app →
# App Information → App-Specific Shared Secret) for verifying receipts.
# APPLE_SHARED_SECRET=...
